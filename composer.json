{
    "name": "migears/captcha",
    "description": "A lightweight captcha generator for PHP 8.1+ with GD extension",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "require": {
        "php": "^8.1",
        "ext-gd": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^2.2"
    },
    "suggest": {
        "ext-mbstring": "Recommended for Unicode-aware case folding in CaptchaVerifier (falls back to strtolower when unavailable)"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Captcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Captcha\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
